<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Pilih Bulan &amp; Tahun Tagihan"
        android:textColor="@color/water_cyan"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/spinnerBulan"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="3"
            android:background="@drawable/bg_glass_input"
            android:paddingHorizontal="12dp" />

        <Spinner
            android:id="@+id/spinnerTahun"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:background="@drawable/bg_glass_input"
            android:paddingHorizontal="12dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnPilih"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_glass_button_primary"
        android:text="Terapkan Periode"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>