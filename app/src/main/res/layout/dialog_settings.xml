<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass_input" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:text="@string/pengaturan_title"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Nama Desa Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Nama Desa / Sub-Header"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etNamaDesa"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_glass_input"
        android:hint="Wanasaba Daya Kec. Wanasaba - Lotim - NTB"
        android:inputType="textCapWords"
        android:paddingHorizontal="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp" />

    <!-- Tarif Rumah Tangga -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Tarif Rumah Tangga (Rp/m³)"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etTarifRt"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_glass_input"
        android:hint="Default: 500"
        android:inputType="number"
        android:paddingHorizontal="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp" />

    <!-- Tarif Pengusaha -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Tarif Pengusaha (Rp/m³)"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etTarifPengusaha"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_glass_input"
        android:hint="Default: 1000"
        android:inputType="number"
        android:paddingHorizontal="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp" />

    <!-- Biaya Beban -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Biaya Beban Per Bulan (Rp)"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etBiayaBeban"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_glass_input"
        android:hint="Default: 2000"
        android:inputType="number"
        android:paddingHorizontal="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp" />

    <!-- Biaya PMA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Dana PMA Per Bulan (Rp)"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etBiayaPma"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_glass_input"
        android:hint="Default: 500"
        android:inputType="number"
        android:paddingHorizontal="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnSimpanPengaturan"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_glass_button_primary"
        android:text="@string/btn_simpan"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>